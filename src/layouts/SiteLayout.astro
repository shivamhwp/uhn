---
import "../styles/global.css";
import { Font } from "astro:assets";
import {
  ArrowClockwiseIcon,
  CaretDownIcon,
  CheckIcon,
  MagnifyingGlassIcon,
  MoonIcon,
  SunIcon,
  XIcon,
} from "@phosphor-icons/react";
import { feedLabels, feedOrder, feedPath } from "../lib/feeds";
import type { FeedType } from "../lib/types";

interface Props {
  title?: string;
  description?: string;
  activeFeed?: FeedType | null;
  searchQuery?: string;
}

const {
  title = "uhn",
  description = "A beautiful, keyboard-driven Hacker News client",
  activeFeed = null,
  searchQuery = "",
} = Astro.props;

const isProd = import.meta.env.PROD;
const activeFeedLabel = activeFeed ? feedLabels[activeFeed] : "Feeds";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ff6600" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="UHN" />

    <Font cssVariable="--font-switzer" preload />

    <script is:inline src="https://assets.onedollarstats.com/stonks.js"></script>

    <script is:inline define:vars={{ isProd }}>
      (function() {
        var t = localStorage.getItem('hn-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', t === 'dark');
      })();

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          if (isProd) {
            navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
            return;
          }

          navigator.serviceWorker.getRegistrations().then(function(registrations) {
            registrations.forEach(function(registration) {
              registration.unregister();
            });
          });

          if ('caches' in window) {
            caches.keys().then(function(keys) {
              keys.forEach(function(key) {
                caches.delete(key);
              });
            });
          }
        });
      }
    </script>
  </head>
  <body>
    <header class="fixed top-0 left-0 right-0 z-40 border-b border-edge bg-bg/80 backdrop-blur-md px-2.5">
      <div class="w-full max-w-4xl mx-auto px-0.5 sm:px-4 h-14 md:h-15 flex items-center gap-2">
        <div class="flex-1 min-w-0 flex items-center gap-2">
          <div id="normal-nav-wrapper" class="flex-1 min-w-0 flex items-center">
            <nav id="feed-nav" class="hidden md:flex items-center gap-1.5">
            {
              feedOrder.map((feedType) => (
                <a
                  href={feedPath(feedType)}
                  class:list={[
                    "h-9 px-3 rounded-md text-xs font-medium transition-colors whitespace-nowrap inline-flex items-center justify-center",
                    {
                      "bg-accent-subtle text-accent": activeFeed === feedType,
                      "text-fg-muted hover:text-fg hover:bg-surface-hover": activeFeed !== feedType,
                    },
                  ]}
                >
                  {feedLabels[feedType]}
                </a>
              ))
            }
          </nav>

          <div id="mobile-feed-dropdown" class="md:hidden relative flex w-full min-w-0">
            <button
              id="mobile-feed-trigger"
              type="button"
              class="h-10 w-full min-w-0 px-3 rounded-md border border-edge bg-surface text-sm text-fg inline-flex items-center justify-between gap-2 hover:bg-surface-hover transition-colors"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="mobile-feed-menu"
            >
              <span id="mobile-feed-label" class="truncate text-left">{activeFeedLabel}</span>
              <CaretDownIcon
                id="mobile-feed-chevron"
                size={14}
                className="text-fg-faint transition-transform duration-200"
              />
            </button>

            <div
              id="mobile-feed-menu"
              class="hidden absolute left-0 right-0 top-[calc(100%+0.45rem)] z-50 w-full min-w-0 rounded-md border border-edge bg-surface shadow-lg p-1 animate-entry"
              role="menu"
            >
              {
                feedOrder.map((feedType) => {
                  const isActive = activeFeed === feedType;
                  return (
                    <a
                      href={feedPath(feedType)}
                      class:list={[
                        "h-9 px-2.5 rounded-sm text-sm inline-flex w-full items-center justify-between transition-colors",
                        {
                          "bg-accent-subtle text-accent": isActive,
                          "text-fg-muted hover:text-fg hover:bg-surface-hover": !isActive,
                        },
                      ]}
                      role="menuitem"
                    >
                      <span>{feedLabels[feedType]}</span>
                      {isActive && <CheckIcon size={14} weight="bold" />}
                    </a>
                  );
                })
              }
            </div>
          </div>
          </div>

          <form
            id="header-search-form"
            action="/search"
            method="get"
            class="hidden flex-1 min-w-0 items-center gap-2"
          >
            <div class="relative flex-1 min-w-0">
              <MagnifyingGlassIcon
                size={16}
                className="absolute left-3 top-1/2 -translate-y-1/2 text-fg-faint"
              />
              <input
                id="header-search-input"
                type="search"
                name="q"
                value={searchQuery}
                placeholder="Search stories..."
                class="w-full h-10 box-border pl-9 pr-3 rounded-md border border-edge bg-surface text-sm text-fg placeholder:text-fg-faint focus:outline-none focus:ring-1 focus:ring-accent/30 focus:border-accent/50"
              />
            </div>
            <button
              id="search-close"
              type="button"
              class="p-2 rounded-md text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
              title="Close search"
            >
              <XIcon size={16} />
            </button>
          </form>
        </div>

        <div class="flex items-center gap-1">
          <button
            id="refresh-feed"
            type="button"
            class="p-2 rounded-md text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
            title="Refresh feeds"
            aria-busy="false"
          >
            <ArrowClockwiseIcon id="refresh-icon" size={16} />
          </button>
          <button
            id="search-toggle"
            type="button"
            class="p-2 rounded-md text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
            title="Search"
            aria-expanded="false"
            aria-controls="header-search-form"
          >
            <MagnifyingGlassIcon size={16} />
          </button>
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-md text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
            title="Toggle theme"
          >
            <SunIcon id="theme-icon-sun" size={16} className="hidden" />
            <MoonIcon id="theme-icon-moon" size={16} />
          </button>
        </div>
      </div>
    </header>

    <main class="w-full max-w-4xl mx-auto h-full px-0.5 sm:px-4 pt-16 pb-4 sm:pb-12">
      <slot />
    </main>

    <div class="fixed bottom-0 right-4 h-7 hidden sm:flex items-center text-lg text-fg-faint/50 z-40">
      made by
      <a
        href="https://claude.ai"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors ml-0.5"
      >
        claude
      </a>
      <span class="mx-0.5">&</span>
      <a
        href="https://shivam.ing"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors"
      >
        shivam
      </a>
    </div>

    <script is:inline>
      (function() {
        var button = document.getElementById('theme-toggle');
        var sunIcon = document.getElementById('theme-icon-sun');
        var moonIcon = document.getElementById('theme-icon-moon');
        var refreshButton = document.getElementById('refresh-feed');
        var refreshIcon = document.getElementById('refresh-icon');
        var searchToggle = document.getElementById('search-toggle');
        var searchClose = document.getElementById('search-close');
        var searchForm = document.getElementById('header-search-form');
        var searchInput = document.getElementById('header-search-input');
        var normalNavWrapper = document.getElementById('normal-nav-wrapper');
        var feedNav = document.getElementById('feed-nav');
        var mobileFeedDropdown = document.getElementById('mobile-feed-dropdown');
        var mobileFeedTrigger = document.getElementById('mobile-feed-trigger');
        var mobileFeedMenu = document.getElementById('mobile-feed-menu');
        var mobileFeedChevron = document.getElementById('mobile-feed-chevron');

        function isTypingTarget(target) {
          if (!target || !(target instanceof HTMLElement)) return false;
          var tag = target.tagName;
          return (
            tag === 'INPUT' ||
            tag === 'TEXTAREA' ||
            tag === 'SELECT' ||
            target.isContentEditable
          );
        }

        function updateThemeIcons() {
          var isDark = document.documentElement.classList.contains('dark');
          if (sunIcon) sunIcon.classList.toggle('hidden', !isDark);
          if (moonIcon) moonIcon.classList.toggle('hidden', isDark);
        }

        function setRefreshing(isRefreshing) {
          if (refreshIcon) refreshIcon.classList.toggle('animate-spin', isRefreshing);
          if (refreshButton) refreshButton.setAttribute('aria-busy', isRefreshing ? 'true' : 'false');
        }

        function closeMobileFeedMenu() {
          if (mobileFeedMenu) mobileFeedMenu.classList.add('hidden');
          if (mobileFeedTrigger) mobileFeedTrigger.setAttribute('aria-expanded', 'false');
          if (mobileFeedChevron) mobileFeedChevron.classList.remove('rotate-180');
        }

        function toggleMobileFeedMenu() {
          if (!mobileFeedMenu) return;
          var isClosed = mobileFeedMenu.classList.contains('hidden');
          if (isClosed) {
            mobileFeedMenu.classList.remove('hidden');
            if (mobileFeedTrigger) mobileFeedTrigger.setAttribute('aria-expanded', 'true');
            if (mobileFeedChevron) mobileFeedChevron.classList.add('rotate-180');
            return;
          }
          closeMobileFeedMenu();
        }

        function openSearch() {
          if (!searchForm) return;
          closeMobileFeedMenu();
          if (normalNavWrapper) normalNavWrapper.classList.add('hidden');
          searchForm.classList.remove('hidden');
          searchForm.classList.add('flex');
          if (searchToggle) searchToggle.setAttribute('aria-expanded', 'true');
          requestAnimationFrame(function() {
            if (searchInput instanceof HTMLElement) searchInput.focus();
          });
        }

        function closeSearch() {
          if (!searchForm) return;
          searchForm.classList.add('hidden');
          searchForm.classList.remove('flex');
          if (normalNavWrapper) normalNavWrapper.classList.remove('hidden');
          if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false');
        }

        if (button) {
          button.addEventListener('click', function() {
            var html = document.documentElement;
            var nextIsDark = !html.classList.contains('dark');
            html.classList.toggle('dark', nextIsDark);
            localStorage.setItem('hn-theme', nextIsDark ? 'dark' : 'light');
            updateThemeIcons();
            window.dispatchEvent(new Event('uhn:theme-change'));
          });
        }

        updateThemeIcons();
        window.addEventListener('uhn:theme-change', updateThemeIcons);

        if (refreshButton) {
          refreshButton.addEventListener('click', function() {
            setRefreshing(true);
            window.dispatchEvent(new Event('uhn:refresh'));
          });
        }
        window.addEventListener('uhn:refresh:start', function() {
          setRefreshing(true);
        });
        window.addEventListener('uhn:refresh:done', function() {
          setRefreshing(false);
        });

        if (searchToggle) {
          searchToggle.addEventListener('click', function() {
            if (!searchForm) return;
            if (searchForm.classList.contains('hidden')) {
              openSearch();
            } else {
              closeSearch();
            }
          });
        }

        if (searchClose) {
          searchClose.addEventListener('click', function() {
            closeSearch();
          });
        }

        if (mobileFeedTrigger) {
          mobileFeedTrigger.addEventListener('click', function() {
            toggleMobileFeedMenu();
          });
        }

        window.addEventListener('pointerdown', function(event) {
          if (!mobileFeedDropdown || !mobileFeedMenu) return;
          if (mobileFeedMenu.classList.contains('hidden')) return;
          if (mobileFeedDropdown.contains(event.target)) return;
          closeMobileFeedMenu();
        });

        if (searchInput instanceof HTMLInputElement && searchInput.value.trim()) {
          openSearch();
        }

        if (window.location.pathname === '/search') {
          openSearch();
        }

        window.addEventListener('keydown', function(event) {
          if (event.key === '/' && !isTypingTarget(document.activeElement)) {
            event.preventDefault();
            openSearch();
          }
          if (event.key === 'Escape' && searchForm && !searchForm.classList.contains('hidden')) {
            closeSearch();
            return;
          }
          if (event.key === 'Escape') {
            closeMobileFeedMenu();
          }
        });

        if (searchForm instanceof HTMLFormElement) {
          searchForm.addEventListener('submit', function(event) {
            if (!(searchInput instanceof HTMLInputElement)) return;
            if (!searchInput.value.trim()) {
              event.preventDefault();
              window.location.assign('/search');
            }
          });
        }

      })();
    </script>
  </body>
</html>
