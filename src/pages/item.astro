---
import { fetchItem } from "../lib/api";
import { StoryIsland } from "../components/islands/StoryIsland";
import SiteLayout from "../layouts/SiteLayout.astro";

export const prerender = false;

const rawId = (Astro.url.searchParams.get("id") ?? "").trim();
const storyId = Number.parseInt(rawId, 10);
const hasValidId = Number.isInteger(storyId) && storyId > 0;
const story = hasValidId ? await fetchItem(storyId) : null;
const initialComments = story?.kids?.length
  ? (
      await Promise.all(
        story.kids.slice(0, 20).map((commentId) => fetchItem(commentId)),
      )
    ).filter((comment) => comment != null)
  : [];
const title = story?.title ? `${story.title} | uhn` : hasValidId ? `Item ${storyId} | uhn` : "Item | uhn";

if (hasValidId) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=60, stale-while-revalidate=600",
  );
}
---

<SiteLayout title={title}>
  {
    hasValidId ? (
      <section class="min-h-0 flex-1 overflow-hidden">
        <StoryIsland
          client:load
          storyId={storyId}
          initialStory={story}
          initialComments={initialComments}
        />
      </section>
    ) : (
      <div class="py-12 px-4 text-center text-sm text-fg-faint">Invalid item id.</div>
    )
  }
</SiteLayout>
