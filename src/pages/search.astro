---
import { SearchIsland } from "../components/islands/SearchIsland";
import SiteLayout from "../layouts/SiteLayout.astro";

export const prerender = false;

const searchQuery = (Astro.url.searchParams.get("q") ?? "").trim();
const title = searchQuery ? `Search: ${searchQuery} | uhn` : "Search | uhn";
---

<SiteLayout title={title} searchQuery={searchQuery}>
  <section class="min-h-0 flex-1 overflow-hidden">
    <SearchIsland client:only="react" initialQuery={searchQuery} />
  </section>
</SiteLayout>
