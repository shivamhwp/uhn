---
import { Font } from "astro:assets";
import { SharedUhnApp } from "../shared/UhnApp";
import "../styles/global.css";
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>uhn</title>
    <meta name="description" content="A keyboard-driven Hacker News client" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <Font cssVariable="--font-geist" preload />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('hn-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', t === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-full bg-bg">
    <SharedUhnApp client:only="preact" initialFeed="top" />
  </body>
</html>
