    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/hotkeys": "^0.4.2",
    "@tanstack/react-query": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.90.27",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.0.40",
    "astro": "^6.0.7",
    "idb-keyval": "^6.2.2",
    "nanostores": "^1.2.0",
    "onedollarstats": "^0.0.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
